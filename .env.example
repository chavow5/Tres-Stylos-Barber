# Copiá este archivo como .env.local para desarrollo local
# En Vercel, cargá estas mismas variables en Settings -> Environment Variables

# Google Sheets (Apps Script Web App)
SHEETS_URL=https://script.google.com/macros/s/TU_DEPLOYMENT_ID/exec
SHEETS_TOKEN=TU_CLAVE_SECRETA

# Login (generá AUTH_PASS_HASH corriendo: node scripts/hash-password.js TU_DNI)
AUTH_USER=Tresstylos
AUTH_PASS_HASH=scrypt$SALT$HASH
AUTH_SECRET=GENERA_UNA_CLAVE_ALEATORIA_LARGA
